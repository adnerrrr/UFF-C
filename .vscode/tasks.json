{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar C",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "${fileDirname}\\*.c", 
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true,
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compila apenas o arquivo C que estiver aberto na tela."
    },
  ]
}